# One optional always-on peer. Each device chooses which independent copies to retain.
TASKASAUR_IMAGE=ghcr.io/taskasaur/taskasaur:edge
APP_PORT=8080
PEER_PORT=8787
APP_BIND=127.0.0.1
PEER_BIND=0.0.0.0
# Server mode never serves frontend assets, even if SERVE_UI is accidentally set.
TASKASAUR_MODE=server
TASKASAUR_NAME=Taskasaur server
# Optional approved live workspace. Choose a file OR a folder.
# Bind-mount the enclosing directory for a file so atomic replacement works.
# /data keeps this instance's separate identity. See docs/workspace-files.md.
TASKASAUR_WORKSPACE_FILE=
TASKASAUR_WORKSPACE_FOLDER=
TASKASAUR_SERVE_UI=0
# Saves memory/CPU by skipping native plugin SQL/workflow/terminal services.
# Set to 0 before enabling native capabilities below.
TASKASAUR_STORAGE_ONLY=1
TASKASAUR_SYNC_INTERVAL_MS=15000
TASKASAUR_DOCUMENT_CACHE=128
TASKASAUR_RELAY=1
# Reachable multiaddress without /p2p/<id>; empty advertises interface addresses.
TASKASAUR_ANNOUNCE=
TASKASAUR_TERMINAL=0
TASKASAUR_AUTOMATION=0
TASKASAUR_TRUSTED_CODE=0
TASKASAUR_BACKGROUND=0
TASKASAUR_PLUGINS=0
PLUGIN_INVENTORY_URL=https://raw.githubusercontent.com/taskasaur/taskasaur-plugin-inventory/main/plugins.json

# Optional path inside the container to a mounted secret containing the workspace password.
TASKASAUR_WORKSPACE_PASSWORD_FILE=
