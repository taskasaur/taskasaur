# Public client configuration only. Never place server credentials in VITE_* variables.
# Leave empty to use this client's /api proxy, or enter a remote server URL.
VITE_SERVER_URL=
# Vite dev/preview proxy; runtime Docker proxy uses TASKASAUR_SERVER_URL instead.
TASKASAUR_API_PROXY_URL=http://127.0.0.1:3000
