# One optional always-on peer. Other devices retain independent local copies.
TASKASAUR_IMAGE=ghcr.io/taskasaur/taskasaur:0.3.0
APP_PORT=8080
PEER_PORT=8787
APP_BIND=127.0.0.1
PEER_BIND=0.0.0.0
TASKASAUR_SERVE_UI=1
TASKASAUR_RELAY=1
# Reachable multiaddress without /p2p/<id>; empty advertises interface addresses.
TASKASAUR_ANNOUNCE=
TASKASAUR_TERMINAL=0
TASKASAUR_AUTOMATION=0
TASKASAUR_TRUSTED_CODE=0
TASKASAUR_BACKGROUND=0
TASKASAUR_PLUGINS=0
PLUGIN_INVENTORY_URL=https://raw.githubusercontent.com/taskasaur/taskasaur-plugin-inventory/main/plugins.json
OFFICE_ASSET_PATH=./.taskasaur/office-engine/wasm
