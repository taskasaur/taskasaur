{
  "name": "taskasaur",
  "version": "0.2.0",
  "description": "Taskasaur web, desktop and mobile client",
  "author": {
    "name": "Taskasaur Contributors",
    "email": "taskasaur@users.noreply.github.com"
  },
  "homepage": "https://taskasaur.net",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config vite.config.ts",
    "build:macos": "npm run build:desktop && electron-builder --mac dmg zip --arm64",
    "build:windows": "npm run build:desktop && electron-builder --win nsis --x64",
    "build:linux": "npm run build:desktop && electron-builder --linux AppImage deb --x64",
    "prepare:ios": "npm run build:client && cap sync ios",
    "prepare:android": "npm run build:client && cap sync android",
    "build:ios": "npm run prepare:ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release -destination generic/platform=iOS -derivedDataPath release/ios CODE_SIGNING_ALLOWED=NO",
    "build:android": "npm run prepare:android && cd android && ./gradlew assembleRelease",
    "preview": "vite preview",
    "electron:dev": "node scripts/desktop.mjs --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "npm run build:desktop && electron-builder --dir",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "dev:native": "vite",
    "build:client": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "start": "vite preview --host 0.0.0.0",
    "office:prepare": "node scripts/office-prepare.mjs",
    "device": "tsx scripts/device.ts",
    "format": "prettier --write packages src electron scripts tests docs",
    "build:desktop": "node scripts/desktop.mjs",
    "postinstall": "node scripts/native-prepare.mjs",
    "prebuild:web": "npm run sdk:verify && npm run core:verify",
    "postbuild:web": "node scripts/offline-assets.mjs",
    "core:verify": "node scripts/core-release.mjs",
    "postbuild:client": "node scripts/offline-assets.mjs",
    "sdk:verify": "node scripts/verify-sdk.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.1.0",
    "@capacitor/ios": "^7.1.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "dompurify": "3.4.16",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "openworkflow": "0.10.1",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "ssh2": "1.17.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "ws": "8.22.0",
    "zod": "^3.25.42",
    "@taskasaur/platform": "file:vendor/taskasaur-platform-0.2.0.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.1.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ssh2": "1.15.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.taskasaur.app",
    "productName": "Taskasaur",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "extraResources": [
      {
        "from": ".taskasaur/office-engine/wasm",
        "to": "office-engine/wasm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ]
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "overrides": {
    "cloudevents": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
