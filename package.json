{
  "name": "taskasaur",
  "version": "0.3.0",
  "description": "Taskasaur distributed workspace: local replicas, peer synchronization, desktop, mobile and headless",
  "author": {
    "name": "Taskasaur Contributors",
    "email": "taskasaur@users.noreply.github.com"
  },
  "homepage": "https://taskasaur.net",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run sdk:build && npm run typecheck && npm run build:web && npm run build:peer",
    "build:web": "vite build --config vite.config.ts",
    "build:macos": "npm run build:desktop && electron-builder --mac dmg zip --arm64",
    "build:windows": "npm run build:desktop && electron-builder --win nsis --x64",
    "build:linux": "npm run build:desktop && electron-builder --linux AppImage deb --x64",
    "prepare:ios": "npm run build:client && cap sync ios",
    "prepare:android": "npm run build:client && cap sync android",
    "build:ios": "npm run prepare:ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release -destination generic/platform=iOS -derivedDataPath release/ios CODE_SIGNING_ALLOWED=NO",
    "build:android": "npm run prepare:android && cd android && ./gradlew assembleRelease",
    "preview": "vite preview",
    "electron:dev": "node scripts/desktop.mjs --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "npm run build:desktop && electron-builder --dir",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "dev:native": "vite",
    "build:client": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "start": "vite preview --host 0.0.0.0",
    "office:prepare": "node scripts/office-prepare.mjs",
    "device": "tsx apps/headless/main.ts",
    "format": "prettier --write packages src electron scripts tests docs",
    "build:desktop": "node scripts/desktop.mjs",
    "postinstall": "node scripts/native-prepare.mjs && npm run sdk:build",
    "prebuild:web": "npm run sdk:verify && npm run core:verify && npm run ui:verify && node scripts/third-party-notices.mjs",
    "postbuild:web": "node scripts/offline-assets.mjs",
    "core:verify": "node scripts/core-release.mjs",
    "postbuild:client": "node scripts/offline-assets.mjs",
    "sdk:verify": "node scripts/verify-sdk.mjs",
    "sdk:build": "node scripts/build-platform.mjs",
    "peer": "tsx apps/headless/main.ts",
    "build:peer": "node scripts/build-peer.mjs",
    "prebuild:client": "npm run ui:verify && node scripts/third-party-notices.mjs",
    "ui:verify": "node scripts/verify-shadcn.mjs",
    "ui:types": "node scripts/build-ui-types.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.1.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/ios": "^7.1.0",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/geist": "^5.2.9",
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/webrtc": "^6.0.33",
    "@libp2p/websockets": "^10.1.21",
    "@multiformats/multiaddr": "^13.0.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@taskasaur/platform": "file:packages/platform",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "docx": "^9.5.1",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "hot-formula-parser": "^4.0.0",
    "libp2p": "^3.3.11",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.11.0",
    "next-themes": "^0.4.6",
    "openworkflow": "0.10.1",
    "pptxgenjs": "^4.0.1",
    "quill": "2.0.2",
    "quill-delta": "5.1.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.1.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.taskasaur.app",
    "productName": "Taskasaur",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "extraResources": [
      {
        "from": ".taskasaur/office-engine/wasm",
        "to": "office-engine/wasm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ]
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "overrides": {
    "cloudevents": {
      "uuid": "11.1.1"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/platform"
  ]
}
